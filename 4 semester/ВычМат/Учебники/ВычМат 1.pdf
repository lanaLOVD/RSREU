  <script language="javascript">
     var pt, hwin;
     var type = 'location';
     var message = '';
     var ok = '/ebs';
     var target = 'opener';
     var cancel = '';
     hwin = (target == '')? this: target;
     if (type == 'location') {
        hwin.location = ok;
     } else if (type == 'confirm'){
        pt = confirm(message);
        hwin.location=(pt)? ok: cancel;
     } else {
        hwin.alert(message);
        hwin.location = ok;
     }
     if (target != '') window.close();
  </script>
