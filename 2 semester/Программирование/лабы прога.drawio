        <mxCell id="htkPhbab9lW_CZMc0jES-107" value="&lt;p class=&quot;MsoNormal&quot; style=&quot;mso-pagination:widow-orphan;tab-stops:45.8pt 91.6pt 137.4pt 183.2pt 229.0pt 274.8pt 320.6pt 366.4pt 412.2pt 458.0pt 503.8pt 549.6pt 595.4pt 641.2pt 687.0pt 732.8pt;&#xa;background:white&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:&amp;quot;Courier New&amp;quot;;&#xa;mso-fareast-font-family:&amp;quot;Times New Roman&amp;quot;;color:black;mso-themecolor:text1;&#xa;mso-fareast-language:RU&quot;&gt;def create_square_dict(start, end):&lt;br&gt;&#xa;&lt;span style=&quot;mso-spacerun:yes&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/span&gt;&lt;i&gt;&quot;&quot;&quot;Создаёт словарь,&#xa;где ключи - числа от start до end, а значения - их квадраты.&quot;&quot;&quot;&lt;br&gt;&#xa;&lt;span style=&quot;mso-spacerun:yes&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/span&gt;&lt;/i&gt;&lt;/span&gt;&lt;span lang=&quot;EN-US&quot; style=&quot;font-size:10.0pt;font-family:&amp;quot;Courier New&amp;quot;;mso-fareast-font-family:&amp;quot;Times New Roman&amp;quot;;&#xa;color:black;mso-themecolor:text1;mso-ansi-language:EN-US;mso-fareast-language:&#xa;RU&quot;&gt;square_dict = {}&lt;br&gt;&#xa;&lt;span style=&quot;mso-spacerun:yes&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/span&gt;for num in range(start, end + 1):&lt;br&gt;&#xa;&lt;span style=&quot;mso-spacerun:yes&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/span&gt;square_dict[num] = num ** 2&lt;br&gt;&#xa;&lt;span style=&quot;mso-spacerun:yes&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/span&gt;return square_dict&lt;br&gt;&#xa;square_dict = create_square_dict(5, 15)&lt;br&gt;&#xa;print(&quot;&lt;/span&gt;&lt;span style=&quot;font-size:10.0pt;font-family:&amp;quot;Courier New&amp;quot;;&#xa;mso-fareast-font-family:&amp;quot;Times New Roman&amp;quot;;color:black;mso-themecolor:text1;&#xa;mso-fareast-language:RU&quot;&gt;Словарь&lt;/span&gt;&lt;span style=&quot;font-size:10.0pt;&#xa;